---
import { Sun, Moon } from "@lucide/astro";
---

<button
    id="theme-toggle"
    class="group relative flex items-center justify-center w-12 h-12 rounded-2xl bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-white/20 dark:border-white/5 hover:border-blue-500/50 transition-all duration-500 shadow-xl overflow-hidden active:scale-95"
    aria-label="Toggle theme"
>
    <div
        class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>

    <div class="relative w-6 h-6 overflow-hidden">
        <div
            class="sun-icon absolute inset-0 transform transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] dark:rotate-[120deg] dark:scale-0 dark:opacity-0 active:scale-75"
        >
            <Sun size={24} stroke-width={1.5} />
        </div>
        <div
            class="moon-icon absolute inset-0 transform transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] -rotate-[120deg] scale-0 opacity-0 dark:rotate-0 dark:scale-100 dark:opacity-100 active:scale-75"
        >
            <Moon size={24} stroke-width={1.5} />
        </div>
    </div>
</button>

<script is:inline>
    const themeToggle = document.getElementById("theme-toggle");

    const toggleTheme = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    };

    const handleToggleClick = (e) => {
        // Check if browser supports View Transitions
        if (!document.startViewTransition) {
            toggleTheme();
            return;
        }

        // Get the click position or button position
        const x = e.clientX ?? themeToggle.getBoundingClientRect().left + 24;
        const y = e.clientY ?? themeToggle.getBoundingClientRect().top + 24;
        const endRadius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y)
        );

        const transition = document.startViewTransition(() => {
            toggleTheme();
        });

        transition.ready.then(() => {
            const clipPath = [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`,
            ];
            document.documentElement.animate(
                {
                    clipPath: document.documentElement.classList.contains(
                        "dark"
                    )
                        ? clipPath
                        : [...clipPath].reverse(),
                },
                {
                    duration: 500,
                    easing: "ease-in-out",
                    pseudoElement: document.documentElement.classList.contains(
                        "dark"
                    )
                        ? "::view-transition-new(root)"
                        : "::view-transition-old(root)",
                }
            );
        });
    };

    themeToggle?.addEventListener("click", handleToggleClick);
</script>
