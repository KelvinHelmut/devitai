---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={["group flex items-center font-mono select-none", className]}
  aria-label="Devitai Logo"
  role="img"
>
  <div
    class="relative flex items-center gap-1 text-2xl md:text-3xl font-black tracking-tighter"
  >
    <!-- Bracket Icon with Inner Glow -->
    <div class="relative">
      <span
        class="text-blue-600 dark:text-blue-400 opacity-60 group-hover:opacity-100 transition-opacity"
        >&lt;</span
      >
      <div
        class="absolute inset-0 blur-[8px] bg-blue-500/30 opacity-0 group-hover:opacity-100 transition-opacity"
      >
      </div>
    </div>

    <div class="flex items-center -mx-0.5">
      <span class="text-slate-900 dark:text-white">Dev</span>
      <div class="relative mx-1">
        <div
          class="h-1.5 w-1.5 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.8)]"
        >
        </div>
        <div
          class="absolute inset-0 animate-ping h-1.5 w-1.5 rounded-full bg-blue-400 opacity-75"
        >
        </div>
      </div>
      <span class="text-slate-700 dark:text-slate-400">it</span>
      <div class="h-1.5 w-1.5 rounded-full bg-indigo-500 mx-1"></div>
      <span class="relative text-indigo-500 dark:text-indigo-400 italic">
        AI
      </span>
    </div>

    <div class="relative">
      <span
        class="text-blue-600 dark:text-blue-400 opacity-60 group-hover:opacity-100 transition-opacity"
        >/&gt;</span
      >
      <div
        class="absolute inset-0 blur-[8px] bg-blue-500/30 opacity-0 group-hover:opacity-100 transition-opacity"
      >
      </div>
    </div>
  </div>
</div>
