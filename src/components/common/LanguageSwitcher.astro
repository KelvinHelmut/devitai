---
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslatedPath } from "../../i18n/utils";
import { Languages } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<div
    class="flex items-center p-1 rounded-none bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-white/20 dark:border-white/5 shadow-xl"
>
    <div
        class="hidden md:block px-3 text-slate-400 border-r border-slate-200 dark:border-slate-800"
    >
        <Languages size={16} />
    </div>
    <div class="flex gap-0.5 md:gap-1 p-0.5">
        {
            Object.entries(languages).map(([l, label]) => (
                <a
                    href={translatePath("/", l)}
                    aria-label={`Change language to ${label}`}
                    class:list={[
                        "px-2.5 md:px-4 py-1.5 md:py-2 rounded-none text-[10px] font-black uppercase tracking-[0.1em] transition-all duration-500",
                        lang === l
                            ? "bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-lg scale-105"
                            : "text-slate-500 hover:text-slate-900 dark:hover:text-slate-100",
                    ]}
                >
                    {l}
                </a>
            ))
        }
    </div>
</div>
