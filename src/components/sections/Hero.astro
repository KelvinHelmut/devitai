---
import { ArrowRight, Code2 } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
    <!-- Parallax glow layers -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-[100px] animate-pulse" style="animation-duration: 4s;"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary/20 rounded-full blur-[100px] animate-pulse" style="animation-duration: 6s; animation-delay: -2s;"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 w-full grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div class="flex flex-col items-start gap-8 reveal active">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-none border border-primary/30 bg-primary/5 text-primary text-xs font-mono tracking-widest uppercase backdrop-blur-md">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                {t('new.hero.badge')}
            </div>
            
            <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[1.1] text-slate-900 dark:text-white">
                {t('new.hero.title')} <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">{t('new.hero.title2')}</span>
            </h1>
            
            <p class="text-slate-600 dark:text-slate-400 text-lg max-w-lg font-light leading-relaxed">
                {t('new.hero.desc')}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 mt-4">
                <a href="#contact" class="group relative px-8 py-4 rounded-none bg-primary text-base font-bold hover:bg-primary/90 transition-all overflow-hidden flex items-center justify-center gap-2 text-slate-900">
                    <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"></div>
                    {t('new.hero.cta1')}
                    <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </a>
                <a href="#work" class="px-8 py-4 rounded-none border border-slate-900/10 dark:border-white/10 hover:border-slate-900/30 dark:hover:border-white/30 text-slate-900 dark:text-white font-bold transition-all flex items-center justify-center backdrop-blur-md hover:bg-slate-900/5 dark:hover:bg-white/5">
                    {t('new.hero.cta2')}
                </a>
            </div>
        </div>

        <!-- Visual / Neural Network Area -->
        <div class="relative h-[500px] w-full hidden lg:flex items-center justify-center reveal reveal-delay-2 active">
            <!-- Simulated brutalist circuit board / neural network visual -->
            <div class="relative w-full h-full max-w-md">
                <!-- Center Node -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 bg-slate-50 dark:bg-base border-2 border-primary rotate-45 flex items-center justify-center z-20 shadow-[0_0_30px_rgba(0,245,255,0.3)]">
                    <div class="w-16 h-16 border border-secondary flex items-center justify-center">
                        <Code2 class="w-8 h-8 text-primary -rotate-45" />
                    </div>
                </div>

                <!-- Connecting Lines (SVG) -->
                <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <line x1="50%" y1="50%" x2="20%" y2="20%" stroke="url(#grad1)" stroke-width="2" />
                    <line x1="50%" y1="50%" x2="80%" y2="20%" stroke="url(#grad2)" stroke-width="2" />
                    <line x1="50%" y1="50%" x2="20%" y2="80%" stroke="url(#grad2)" stroke-width="2" />
                    <line x1="50%" y1="50%" x2="80%" y2="80%" stroke="url(#grad1)" stroke-width="2" />
                    
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#00F5FF" stop-opacity="0.8" />
                            <stop offset="100%" stop-color="#080810" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="grad2" x1="100%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#9B5DE5" stop-opacity="0.8" />
                            <stop offset="100%" stop-color="#080810" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                </svg>

                <!-- Floating Nodes -->
                <div class="absolute top-[20%] left-[20%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 bg-primary animate-pulse shadow-[0_0_15px_#00F5FF]"></div>
                <div class="absolute top-[20%] right-[20%] translate-x-1/2 -translate-y-1/2 w-4 h-4 bg-secondary animate-pulse shadow-[0_0_15px_#9B5DE5]" style="animation-delay: 1s;"></div>
                <div class="absolute bottom-[20%] left-[20%] -translate-x-1/2 translate-y-1/2 w-4 h-4 bg-secondary animate-pulse shadow-[0_0_15px_#9B5DE5]" style="animation-delay: 0.5s;"></div>
                <div class="absolute bottom-[20%] right-[20%] translate-x-1/2 translate-y-1/2 w-4 h-4 bg-primary animate-pulse shadow-[0_0_15px_#00F5FF]" style="animation-delay: 1.5s;"></div>
            </div>
        </div>
    </div>
</section>
