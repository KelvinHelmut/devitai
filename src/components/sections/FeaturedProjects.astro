---
import { ArrowRight } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Image } from "astro:assets";
import gesproImg from "../../assets/gespro.png";
import gesconImg from "../../assets/gescon.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
    {
        title: t('new.work.proj1.title'),
        category: t('new.work.proj1.category'),
        metric: t('new.work.proj1.metric'),
        desc: t('new.work.proj1.desc'),
        image: gesproImg,
        color: "text-primary"
    },
    {
        title: t('new.work.proj2.title'),
        category: t('new.work.proj2.category'),
        metric: t('new.work.proj2.metric'),
        desc: t('new.work.proj2.desc'),
        image: gesconImg,
        color: "text-secondary"
    }
];
---

<section id="work" class="py-32 relative z-10 bg-slate-900/5 dark:bg-white/5 border-y border-slate-900/5 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 reveal">
            <div>
                <h2 class="text-xs font-mono text-primary uppercase tracking-[0.3em] mb-4">{t('new.work.badge')}</h2>
                <h3 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white">{t('new.work.title')}</h3>
            </div>
            <a href="#" class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors font-mono text-sm uppercase tracking-widest group">
                {t('new.work.cta')} <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {projects.map((project, index) => (
                <div class={`group border border-slate-900/10 dark:border-white/10 bg-slate-50 dark:bg-base overflow-hidden reveal reveal-delay-${index + 1}`}>
                    <div class="h-64 w-full relative overflow-hidden bg-slate-900">
                        <Image src={project.image} alt={project.title} class="absolute inset-0 w-full h-full object-cover opacity-50 dark:opacity-70 group-hover:scale-110 group-hover:opacity-70 dark:group-hover:opacity-100 transition-all duration-700" />
                        <!-- Animated Grid overlay -->
                        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+PHBhdGggZD0iTTAgMGg0MHY0MEgwVjB6bTIwIDIwaDIwdjIwSDIwaC0yMHYtMjB6IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDMiLz48L3N2Zz4=')] opacity-30 dark:opacity-50 pointer-events-none"></div>
                        <div class="absolute top-4 left-4 px-3 py-1 bg-slate-50/80 dark:bg-base/80 backdrop-blur-md border border-slate-900/10 dark:border-white/10 text-xs font-mono text-slate-900 dark:text-white uppercase tracking-widest z-10">
                            {project.category}
                        </div>
                    </div>
                    
                    <div class="p-8">
                        <div class={`text-2xl font-black ${project.color} mb-2`}>{project.metric}</div>
                        <h4 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">{project.title}</h4>
                        <p class="text-slate-600 dark:text-slate-400 font-light leading-relaxed mb-8">{project.desc}</p>
                        
                        <a href="#" aria-label={`${t('new.work.view_project')} ${project.title}`} class="inline-flex items-center justify-center w-12 h-12 rounded-none border border-slate-900/20 dark:border-white/20 text-slate-900 dark:text-white hover:bg-slate-900 dark:hover:bg-white hover:text-white dark:hover:text-base transition-colors">
                            <ArrowRight class="w-5 h-5 -rotate-45" />
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
