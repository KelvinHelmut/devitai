---
import { useTranslations, getLangFromUrl } from "../../i18n/utils";
import {
    MessageSquare,
    Send,
    Sparkles,
    Calendar,
    ArrowRight,
    Loader2,
    CheckCircle2,
    Mail,
} from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
    id="contact"
    class="py-40 relative overflow-hidden bg-slate-50/50 dark:bg-black/20"
>
    <!-- Decorative Atmosphere -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/5 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 text-blue-400 text-[10px] font-black tracking-widest uppercase mb-6"
            >
                <Sparkles size={12} />
                <span>{t("contact.badge")}</span>
            </div>
            <h2
                class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter text-slate-900 dark:text-white mb-8"
            >
                {t("contact.title")}
            </h2>
            <p
                class="text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed"
            >
                {t("contact.subtitle")}
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left: n8n Automated Form -->
            <div class="lg:col-span-7">
                <div
                    class="relative group p-8 md:p-12 rounded-[2.5rem] border border-slate-200 dark:border-white/5 bg-white dark:bg-slate-900/40 backdrop-blur-xl shadow-2xl overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <Send size={80} />
                    </div>

                    <div class="relative z-10 h-full flex flex-col">
                        <h3
                            class="text-3xl font-black text-slate-900 dark:text-white mb-2"
                        >
                            {t("contact.form.title")}
                        </h3>
                        <p
                            class="text-slate-500 dark:text-slate-400 mb-10 text-lg"
                        >
                            {t("contact.form.subtitle")}
                        </p>

                        <form id="n8n-contact-form" class="space-y-4">
                            <div class="space-y-4">
                                <input
                                    type="text"
                                    name="name"
                                    id="name-input"
                                    required
                                    autocomplete="name"
                                    placeholder={t(
                                        "contact.form.name_placeholder"
                                    )}
                                    class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-2xl px-6 py-5 text-lg text-slate-900 dark:text-white focus:border-blue-500 outline-none transition-all placeholder:text-slate-400 font-medium"
                                />
                                <div
                                    class="flex flex-col sm:relative gap-3 sm:gap-0"
                                >
                                    <input
                                        type="text"
                                        name="contact"
                                        id="contact-input"
                                        required
                                        autocomplete="email"
                                        placeholder={t(
                                            "contact.form.placeholder"
                                        )}
                                        class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-2xl px-6 sm:pr-44 py-5 text-lg text-slate-900 dark:text-white focus:border-blue-500 outline-none transition-all placeholder:text-slate-400 font-medium"
                                    />
                                    <button
                                        type="submit"
                                        id="submit-btn"
                                        class="sm:absolute relative sm:right-2 sm:top-2 sm:bottom-2 px-6 py-4 sm:py-0 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm uppercase tracking-widest hover:scale-[1.02] sm:hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2"
                                    >
                                        <span id="btn-text"
                                            >{t("contact.form.submit")}</span
                                        >
                                        <ArrowRight size={16} id="btn-icon" />
                                        <Loader2
                                            size={16}
                                            id="btn-loader"
                                            class="hidden animate-spin"
                                        />
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="flex-1"></div>

                        <div
                            id="success-message"
                            class="hidden mt-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3 animate-fade-in"
                        >
                            <CheckCircle2 size={20} />
                            <p class="text-sm font-bold">
                                {t("contact.form.success")}
                            </p>
                        </div>
                    </div>

                    <!-- Technical Meta Footer -->
                    <div
                        class="mt-12 flex items-center gap-4 text-[10px] font-mono text-slate-400 uppercase tracking-[0.2em] opacity-50"
                    >
                        <div class="flex gap-1">
                            <div class="w-1.5 h-1.5 rounded-full bg-blue-500">
                            </div>
                            <div
                                class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"
                            >
                            </div>
                        </div>
                        <span>Protocol: Webhook_v2.1 / n8n_automata</span>
                    </div>
                </div>
            </div>

            <!-- Right: Direct Channels -->
            <div class="lg:col-span-5 flex flex-col h-full gap-6">
                <!-- Cal.com Card -->
                <a
                    href="https://cal.com/kelvin-helmut/15min"
                    target="_blank"
                    class="group relative flex-1 block w-full text-left p-8 rounded-[2.5rem] border border-slate-200 dark:border-white/5 bg-white dark:bg-slate-900/40 backdrop-blur-sm hover:border-blue-500/30 transition-all duration-500 overflow-hidden"
                >
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>

                    <div class="flex items-start justify-between mb-6">
                        <div
                            class="p-4 rounded-2xl bg-blue-600 text-white shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <Calendar size={28} />
                        </div>
                        <div
                            class="text-[10px] font-mono text-blue-500 uppercase tracking-widest border border-blue-500/20 px-2 py-1 rounded-md"
                        >
                            Live_Sync
                        </div>
                    </div>

                    <h3
                        class="text-2xl font-bold text-slate-900 dark:text-white mb-2"
                    >
                        {t("contact.cal.title")}
                    </h3>
                    <p
                        class="text-slate-500 dark:text-slate-400 text-sm mb-8 leading-relaxed"
                    >
                        {t("contact.cal.desc")}
                    </p>

                    <div
                        class="flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400"
                    >
                        {t("contact.cal.cta")}
                        <ArrowRight
                            size={14}
                            class="group-hover:translate-x-2 transition-transform"
                        />
                    </div>
                </a>

                <!-- Secondary Channels Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- WhatsApp Quick Action -->
                    <a
                        href="https://wa.me/51954733536"
                        target="_blank"
                        class="group p-5 rounded-3xl border border-emerald-500/10 bg-emerald-500/5 hover:bg-emerald-500/10 transition-all duration-500 flex flex-col items-center text-center"
                    >
                        <div
                            class="p-2 rounded-xl bg-emerald-600 text-white mb-3 shadow-emerald-500/20 shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <MessageSquare size={16} />
                        </div>
                        <p
                            class="text-[11px] font-bold text-slate-900 dark:text-white font-mono truncate w-full"
                        >
                            +51 954 733 536
                        </p>
                    </a>

                    <!-- Email Quick Action -->
                    <a
                        href="mailto:info@devitai.com"
                        class="group p-5 rounded-3xl border border-blue-500/10 bg-blue-500/5 hover:bg-blue-500/10 transition-all duration-500 flex flex-col items-center text-center"
                    >
                        <div
                            class="p-2 rounded-xl bg-blue-600 text-white mb-3 shadow-blue-500/20 shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <Mail size={16} />
                        </div>
                        <p
                            class="text-[11px] font-bold text-slate-900 dark:text-white font-mono truncate w-full"
                        >
                            info@devitai.com
                        </p>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    const form = document.getElementById("n8n-contact-form");
    const nameInput = document.getElementById("name-input");
    const contactInput = document.getElementById("contact-input");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");
    const btnIcon = document.getElementById("btn-icon");
    const btnLoader = document.getElementById("btn-loader");
    const successMsg = document.getElementById("success-message");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const nameValue = nameInput?.value;
        const contactValue = contactInput?.value;
        if (!nameValue || !contactValue) return;

        // Visual State: Loading
        submitBtn.disabled = true;
        btnText.classList.add("hidden");
        btnIcon.classList.add("hidden");
        btnLoader.classList.remove("hidden");

        try {
            // Reemplaza esta URL con tu Webhook de n8n real
            const WEBHOOK_URL = "https://n8n.devitai.com/webhook/contact-lead";

            // Simulación de envío (En producción se usa el fetch de abajo comentado)
            await new Promise((resolve) => setTimeout(resolve, 1500));

            /* 
            const response = await fetch(WEBHOOK_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    name: nameValue,
                    contact: contactValue,
                    source: window.location.href,
                    timestamp: new Date().toISOString()
                })
            });
            */

            // Visual State: Success
            successMsg.classList.remove("hidden");
            form.classList.add("opacity-50", "pointer-events-none");
            submitBtn.style.display = "none";

            if (nameInput) nameInput.value = "";
            if (contactInput) contactInput.value = "";
        } catch (error) {
            console.error("Submission failed:", error);
            alert("Algo falló. Por favor intenta por WhatsApp.");
        } finally {
            btnLoader.classList.add("hidden");
            btnText.classList.remove("hidden");
            btnIcon.classList.remove("hidden");
            submitBtn.disabled = false;
        }
    });
</script>
