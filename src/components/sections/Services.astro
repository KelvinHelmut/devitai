---
import { BrainCircuit, Code, Cloud } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
    {
        title: t('new.services.serv1.title'),
        desc: t('new.services.serv1.desc'),
        icon: Code,
        color: "group-hover:text-primary",
        border: "group-hover:border-primary/50"
    },
    {
        title: t('new.services.serv2.title'),
        desc: t('new.services.serv2.desc'),
        icon: BrainCircuit,
        color: "group-hover:text-secondary",
        border: "group-hover:border-secondary/50"
    },
    {
        title: t('new.services.serv3.title'),
        desc: t('new.services.serv3.desc'),
        icon: Cloud,
        color: "group-hover:text-primary",
        border: "group-hover:border-primary/50"
    }
];
---

<section id="services" class="py-32 relative z-10">
    <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16 reveal">
            <h2 class="text-xs font-mono text-primary uppercase tracking-[0.3em] mb-4">{t('new.services.badge')}</h2>
            <h3 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white">{t('new.services.title')}</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {services.map((service, index) => (
                <div class={`group relative p-8 glass-card border border-slate-900/5 dark:border-white/5 bg-slate-900/5 dark:bg-white/5 hover:bg-slate-900/10 dark:hover:bg-white/10 transition-all duration-500 reveal reveal-delay-${index % 3 + 1} overflow-hidden cursor-pointer ${service.border}`}>
                    <!-- Hover Glow Effect -->
                    <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                    
                    <div class={`mb-6 p-4 bg-slate-50 dark:bg-base inline-block border border-slate-900/10 dark:border-white/10 transition-colors duration-500 ${service.border}`}>
                        <service.icon class={`w-8 h-8 text-slate-500 dark:text-slate-400 transition-colors duration-500 ${service.color}`} />
                    </div>
                    
                    <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{service.title}</h4>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed font-light">{service.desc}</p>
                    
                    <!-- Decorative Corner -->
                    <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-slate-900/20 dark:border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-500 -translate-x-4 translate-y-4 group-hover:translate-x-0 group-hover:translate-y-0"></div>
                </div>
            ))}
        </div>
    </div>
</section>
