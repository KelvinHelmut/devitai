---
const techStack = [
    "Python", "TypeScript", "React", "FastAPI", "LangChain", 
    "OpenAI", "AWS", "Docker", "PostgreSQL", "Kubernetes", "Astro", "TailwindCSS"
];
---

<section id="stack" class="py-24 border-y border-slate-900/5 dark:border-white/5 bg-slate-50 dark:bg-base relative overflow-hidden flex flex-col justify-center">
    <!-- Fade edges -->
    <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-slate-50 dark:from-base to-transparent z-10"></div>
    <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-slate-50 dark:from-base to-transparent z-10"></div>

    <div class="flex overflow-hidden group">
        <div class="flex animate-marquee whitespace-nowrap group-hover:[animation-play-state:paused]">
            {[...techStack, ...techStack, ...techStack].map((tech) => (
                <div class="mx-8 flex items-center gap-4">
                    <span class="text-3xl md:text-5xl font-black text-slate-200 dark:text-slate-800 uppercase tracking-tighter hover:text-slate-900 dark:hover:text-white transition-colors cursor-default select-none">
                        {tech}
                    </span>
                    <span class="w-2 h-2 rounded-full bg-primary/20"></span>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
    
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-33.33%); }
    }
</style>
