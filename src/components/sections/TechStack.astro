---
import { useTranslations, getLangFromUrl } from "../../i18n/utils";
import { Sparkles } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const technologies = [
    "Python",
    "Django",
    "PostgreSQL",
    "Astro",
    "Docker",
    "OpenAI",
    "LangChain",
    "n8n",
    "React",
    "AWS",
    "PyTorch",
    "FastAPI",
    "Redis",
    "Kubernetes",
];
---

<section
    id="stack"
    class="py-40 relative overflow-hidden bg-slate-900 dark:bg-black"
>
    <div
        class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 via-transparent to-transparent"
    >
    </div>

    <div
        class="max-w-7xl mx-auto px-6 mb-20 relative z-10 flex flex-col items-center"
    >
        <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 text-blue-400 text-[10px] font-black tracking-widest uppercase mb-6"
        >
            <Sparkles size={12} />
            <span>{t("stack.badge")}</span>
        </div>
        <h2
            class="text-4xl md:text-5xl font-bold tracking-tight text-white text-center"
        >
            {t("marquee.title")}
        </h2>
    </div>

    <div
        class="relative flex overflow-x-hidden border-y border-white/5 py-10 bg-white/[0.02]"
    >
        <div class="py-12 animate-marquee whitespace-nowrap flex items-center">
            {
                technologies.map((tech) => (
                    <div class="mx-16 flex items-center gap-4 group cursor-pointer">
                        <span class="text-5xl md:text-7xl font-black text-white/10 group-hover:text-blue-500/40 transition-colors uppercase tracking-tighter">
                            {tech}
                        </span>
                        <div class="w-2 h-2 rounded-full bg-blue-600 opacity-20 group-hover:scale-150 group-hover:opacity-100 transition-all" />
                    </div>
                ))
            }
        </div>
        <div
            class="absolute top-0 py-12 animate-marquee2 whitespace-nowrap flex items-center h-full"
        >
            {
                technologies.map((tech) => (
                    <div class="mx-16 flex items-center gap-4 group cursor-pointer">
                        <span class="text-5xl md:text-7xl font-black text-white/10 group-hover:text-blue-500/40 transition-colors uppercase tracking-tighter">
                            {tech}
                        </span>
                        <div class="w-2 h-2 rounded-full bg-blue-600 opacity-20 group-hover:scale-150 group-hover:opacity-100 transition-all" />
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Decorative Gradient -->
    <div
        class="absolute left-0 top-0 bottom-0 w-40 bg-gradient-to-r from-slate-900 dark:from-black to-transparent z-20"
    >
    </div>
    <div
        class="absolute right-0 top-0 bottom-0 w-40 bg-gradient-to-l from-slate-900 dark:from-black to-transparent z-20"
    >
    </div>
</section>

<style>
    .animate-marquee {
        animation: marquee 40s linear infinite;
    }
    .animate-marquee2 {
        animation: marquee2 40s linear infinite;
    }

    @keyframes marquee {
        0% {
            transform: translateX(0%);
        }
        100% {
            transform: translateX(-100%);
        }
    }

    @keyframes marquee2 {
        0% {
            transform: translateX(100%);
        }
        100% {
            transform: translateX(0%);
        }
    }
</style>
