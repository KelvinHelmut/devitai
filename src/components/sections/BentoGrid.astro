---
import { useTranslations, getLangFromUrl } from '../../i18n/utils';
import { Code2, BrainCircuit, Network, ChevronRight, Binary, Cpu, Globe, Sparkles } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    id: 'software_forge',
    title: t('services.software_forge.title'),
    desc: t('services.software_forge.desc'),
    icon: Code2,
    techs: ['Python', 'Django', 'PostgreSQL'],
    gridClass: 'md:col-span-2 lg:col-span-2 lg:row-span-1',
    bg: 'from-blue-500/10',
    layout: 'horizontal'
  },
  {
    id: 'ai_automation',
    title: t('services.ai_automation.title'),
    desc: t('services.ai_automation.desc'),
    icon: BrainCircuit,
    techs: ['OpenAI', 'LangChain', 'n8n'],
    gridClass: 'md:col-span-1 md:row-span-2 lg:col-span-1 lg:row-span-2',
    bg: 'from-indigo-500/10',
    layout: 'vertical'
  },
  {
    id: 'smart_infra',
    title: t('services.smart_infra.title'),
    desc: t('services.smart_infra.desc'),
    icon: Network,
    techs: ['Docker', 'AWS', 'IoT'],
    gridClass: 'md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1',
    bg: 'from-purple-500/10',
    layout: 'compact'
  },
  {
    id: 'custom_dev',
    title: t('services.global.title'),
    desc: t('services.global.desc'),
    icon: Globe,
    techs: ['Kubernetes', 'Redis', 'Nginx'],
    gridClass: 'md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1',
    bg: 'from-emerald-500/10',
    layout: 'compact'
  }
];
---

<section id="services" class="py-40 relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20">
      <div class="flex flex-col items-center">
        <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-blue-600 dark:text-blue-500 mb-6 font-mono border border-blue-500/20 px-3 py-1 rounded-full">{t('services.badge')}</h2>
        <h3 class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter text-slate-900 dark:text-white leading-[0.9] mb-8">
          {t('services.title')}
        </h3>
        <div class="flex items-center gap-3 text-slate-400 font-mono text-[10px] uppercase tracking-[0.2em] opacity-60">
          <Binary size={14} />
          <span>{t('services.year')}</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:auto-rows-fr">
      {services.map((service, index) => (
        <div 
          class:list={[
            "group relative p-8 sm:p-10 rounded-[2.5rem] border border-slate-200/60 dark:border-white/5 bg-white dark:bg-slate-900/40 backdrop-blur-sm overflow-hidden flex flex-col hover:border-blue-500/30 transition-all duration-500 min-h-[320px] md:min-h-[350px] lg:min-h-[300px] h-full",
            service.gridClass
          ]}
        >
          <!-- Background Glow Effect -->
          <div class:list={["absolute top-0 right-0 w-64 h-64 bg-gradient-to-br transition-all duration-700 opacity-0 group-hover:opacity-100 blur-[80px]", service.bg]}></div>
          
          <div class:list={["relative z-10 h-full flex flex-col", service.layout === 'horizontal' ? 'sm:grid sm:grid-cols-12 sm:gap-10 sm:items-center' : 'justify-between']}>
            
            <div class:list={[service.layout === 'horizontal' ? 'sm:col-span-7' : '']}>
              <div class="inline-flex p-4 rounded-2xl bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white group-hover:bg-blue-600 group-hover:text-white transition-all duration-500 group-hover:scale-110 group-hover:rotate-3 mb-8">
                <service.icon size={28} />
              </div>

              <div>
                <h4 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 text-slate-900 dark:text-white group-hover:translate-x-1 transition-transform">
                  {service.title}
                </h4>
                <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-8 max-w-full text-sm md:text-base">
                  {service.desc}
                </p>

                <div class="flex flex-wrap gap-2">
                  {service.techs.map(tech => (
                    <span class="text-[9px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full border border-slate-100 dark:border-slate-800 text-slate-400 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            {service.layout === 'horizontal' && (
              <div class="hidden sm:flex sm:col-span-5 items-center justify-center relative h-full min-h-[200px]">
                <!-- Software Forge: Automated Construction Visual -->
                <div class="relative w-full max-w-[240px] h-40 opacity-70 group-hover:opacity-100 transition-all duration-700">
                  <div class="absolute inset-x-0 bottom-0 h-[1px] bg-blue-500/20"></div>
                  <div class="flex items-end justify-center gap-3 h-full pb-4">
                    {[0.6, 1, 0.8, 0.4].map((h, i) => (
                      <div class="w-8 flex flex-col items-center gap-2">
                        <div 
                          class="w-full bg-blue-500/10 border border-blue-500/20 rounded-t-lg relative overflow-hidden group-hover:border-blue-500/40 transition-colors"
                          style={`height: ${h * 100}%; transition-delay: ${i * 100}ms;`}
                        >
                          <div class="absolute inset-0 bg-gradient-to-t from-blue-500/10 to-transparent"></div>
                          <div class="absolute top-1 left-1.5 right-1.5 h-[1px] bg-blue-400/30"></div>
                          <div class="absolute inset-0 bg-blue-500/10 animate-pulse" style={`animation-delay: ${i * 0.5}s;`}></div>
                        </div>
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-500/20 group-hover:bg-blue-500/50"></div>
                      </div>
                    ))}
                  </div>
                  <!-- Floating Code Bits -->
                  <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
                    <div class="absolute top-2 left-4 px-3 py-1 rounded-md bg-blue-500/10 border border-blue-500/20 text-[10px] font-mono text-blue-500/70 animate-bounce">FUNC main()</div>
                    <div class="absolute top-10 right-2 px-3 py-1 rounded-md bg-blue-500/10 border border-blue-500/20 text-[10px] font-mono text-blue-500/70 animate-[bounce_2s_infinite_1s]">RETURN true</div>
                  </div>
                </div>
              </div>
            )}

            {service.id === 'ai_automation' && (
              <div class="hidden sm:flex flex-1 items-center justify-center my-8 relative group/ai">
                <!-- Agentic Workflow Orchestrator Visual -->
                <div class="relative w-full max-w-[270px] aspect-square flex items-center justify-center opacity-70 group-hover:opacity-100 transition-all duration-700">
                  <!-- Central Node -->
                  <div class="relative z-10 w-20 h-20 rounded-[2rem] border border-indigo-500/30 bg-indigo-500/5 flex items-center justify-center shadow-xl shadow-indigo-500/5 group-hover/ai:scale-110 group-hover/ai:rotate-12 transition-all duration-700">
                    <BrainCircuit size={42} class="text-indigo-500" />
                    <div class="absolute inset-0 rounded-[2rem] border border-indigo-500/40 animate-ping opacity-20 group-hover/ai:opacity-40"></div>
                  </div>

                  <!-- Orbiting Agents -->
                  {[0, 90, 180, 270].map((angle, i) => (
                    <div 
                      class="absolute flex flex-col items-center gap-2 group-hover/ai:opacity-100 transition-all duration-700"
                      style={`transform: rotate(${angle}deg) translateY(-90px) rotate(-${angle}deg); opacity: 0.4;`}
                    >
                      <div class="w-10 h-10 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center justify-center shadow-sm">
                        {i === 0 && <Code2 size={18} class="text-indigo-400" />}
                        {i === 1 && <Cpu size={18} class="text-indigo-400" />}
                        {i === 2 && <Globe size={18} class="text-indigo-400" />}
                        {i === 3 && <Sparkles size={18} class="text-indigo-400" />}
                      </div>
                      <!-- Connecting Line -->
                      <div 
                        class="absolute top-1/2 left-1/2 origin-top h-[90px] w-[1px] bg-gradient-to-b from-transparent to-indigo-500/20 -z-10"
                        style={`transform: rotate(${angle + 180}deg);`}
                      ></div>
                    </div>
                  ))}

                  <!-- Glowing background -->
                  <div class="absolute inset-0 bg-indigo-500/5 blur-[80px] rounded-full opacity-60"></div>
                </div>
              </div>
            )}
          </div>

          <div class="absolute bottom-10 right-10 opacity-0 group-hover:opacity-100 translate-x-4 group-hover:translate-x-0 transition-all duration-300 pointer-events-none">
            <ChevronRight size={24} class="text-blue-600 dark:text-blue-400" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
