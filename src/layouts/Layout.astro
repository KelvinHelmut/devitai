---
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
} from "../i18n/utils";
import Logo from "../components/common/Logo.astro";
import ThemeSwitcher from "../components/common/ThemeSwitcher.astro";
import LanguageSwitcher from "../components/common/LanguageSwitcher.astro";
import ScrollToTop from "../components/common/ScrollToTop.astro";
import { Menu, X, Mail } from "@lucide/astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title,
    description = "Devitai - Boutique AI & Software Engineering Agency",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <!-- Theme Blocking Script (Highest Priority) -->
        <script is:inline>
            const getInitialTheme = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            };

            const theme = getInitialTheme();
            const element = document.documentElement;

            if (theme === "dark") {
                element.classList.add("dark");
                element.style.colorScheme = "dark";
            } else {
                element.classList.remove("dark");
                element.style.colorScheme = "light";
            }

            window.toggleTheme = () => {
                const isDark = element.classList.toggle("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
                element.style.colorScheme = isDark ? "dark" : "light";
                return isDark;
            };
        </script>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO Labels -->
        <title>{title || t("site.title")}</title>
        <meta
            name="description"
            content={description || t("site.description")}
        />
        <link
            rel="canonical"
            href={new URL(
                Astro.url.pathname,
                Astro.site || "https://devitai.com"
            )}
        />

        <!-- I18n SEO -->
        <link rel="alternate" hreflang="es" href="https://devitai.com/" />
        <link rel="alternate" hreflang="en" href="https://devitai.com/en/" />
        <link
            rel="alternate"
            hreflang="x-default"
            href="https://devitai.com/"
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title || t("site.title")} />
        <meta
            property="og:description"
            content={description || t("site.description")}
        />
        <meta property="og:image" content="https://devitai.com/og-image.png" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title || t("site.title")} />
        <meta
            property="twitter:description"
            content={description || t("site.description")}
        />
        <meta
            property="twitter:image"
            content="https://devitai.com/og-image.png"
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Optimized Async Font Loading -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
    </head>
    <body
        class="bg-slate-50 dark:bg-base text-slate-900 dark:text-slate-100 font-sans selection:bg-primary/30 selection:text-primary grain cursor-none"
    >
        <!-- Custom Cursor -->
        <div id="cursor-dot" class="fixed w-2 h-2 bg-slate-900 dark:bg-primary rounded-full pointer-events-none z-[9999] dark:mix-blend-screen -translate-x-1/2 -translate-y-1/2 transition-transform duration-100 ease-out"></div>
        <div id="cursor-glow" class="fixed w-16 h-16 bg-slate-900/10 dark:bg-primary/20 blur-xl rounded-full pointer-events-none z-[9998] dark:mix-blend-screen -translate-x-1/2 -translate-y-1/2 transition-transform duration-300 ease-out"></div>

        <!-- Premium Grid Background -->
        <div
            class="fixed inset-0 z-[-1] animate-grid opacity-30 dark:opacity-40 pointer-events-none"
        >
        </div>

        <!-- Background Orbs -->
        <div
            class="fixed top-[-10%] left-[-10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-primary/10 rounded-full blur-[120px] pointer-events-none animate-float dark:mix-blend-screen"
        >
        </div>
        <div
            class="fixed bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-secondary/10 rounded-full blur-[120px] pointer-events-none animate-float dark:mix-blend-screen"
            style="animation-delay: -3s;"
        >
        </div>

        <!-- Header -->
        <header
            class="fixed top-0 left-0 right-0 z-[100] border-b border-slate-200/40 dark:border-white/5 backdrop-blur-2xl bg-white/60 dark:bg-slate-950/60"
        >
            <nav
                class="max-w-7xl mx-auto px-4 md:px-6 h-20 flex items-center justify-between"
            >
                <a
                    href={translatePath("/")}
                    class="hover:opacity-80 transition-opacity flex-shrink-0"
                >
                    <Logo class="scale-90 md:scale-100 origin-left" />
                </a>

                <!-- Desktop Nav -->
                <div
                    class="hidden md:flex items-center gap-10 text-sm font-semibold tracking-tight"
                >
                    <a
                        href="#services"
                        class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest text-[11px]"
                        >{t("nav.services")}</a
                    >
                    <a
                        href="#work"
                        class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest text-[11px]"
                        >{t("nav.work")}</a
                    >
                    <a
                        href="#contact"
                        class="px-6 py-2.5 rounded-none border border-slate-900 dark:border-white bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-transparent dark:hover:bg-transparent hover:text-slate-900 dark:hover:text-white transition-all shadow-lg shadow-black/10 dark:shadow-white/5"
                        >{t("nav.contact")}</a
                    >
                </div>

                <!-- Right Side Tools -->
                <div class="flex items-center gap-2 md:gap-6">
                    <LanguageSwitcher />
                    <ThemeSwitcher />

                    <!-- Mobile Menu Toggle -->
                    <button
                        id="mobile-menu-toggle"
                        class="md:hidden p-2.5 rounded-none border border-slate-900 dark:border-white bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-transparent dark:hover:bg-transparent hover:text-slate-900 dark:hover:text-white transition-all active:scale-95"
                        aria-label="Toggle menu"
                    >
                        <div id="menu-icon">
                            <Menu size={20} />
                        </div>
                        <div id="close-icon" class="hidden">
                            <X size={20} />
                        </div>
                    </button>
                </div>
            </nav>
        </header>

        <!-- Mobile Navigation Overlay -->
        <div
            id="mobile-menu"
            class="fixed inset-0 z-[200] backdrop-blur-2xl bg-white/60 dark:bg-slate-950/60 flex-col items-center justify-between py-16 px-8 hidden md:hidden opacity-0 translate-y-8 transition-all duration-500 overflow-y-auto"
        >
            <!-- Close button inside overlay -->
            <button
                id="mobile-menu-close"
                class="absolute top-6 right-6 p-4 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors hover:rotate-90 duration-300"
                aria-label="Close menu"
            >
                <X size={32} stroke-width={1.5} />
            </button>

            <div class="flex flex-col items-center gap-10 w-full mt-12">
                <a
                    href="#"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                >
                    {t("nav.home")}
                </a>
                <a
                    href="#services"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                    >{t("nav.services")}</a
                >
                <a
                    href="#work"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                    >{t("nav.work")}</a
                >
                <a
                    href="#contact"
                    class="mobile-nav-link px-12 py-5 rounded-none border border-primary bg-primary text-base font-black shadow-2xl shadow-primary/20 hover:bg-transparent hover:text-primary transition-colors text-center w-full max-w-[300px]"
                    >{t("nav.contact")}</a
                >
            </div>

            <div
                class="mt-16 pt-10 border-t border-slate-200 dark:border-white/5 w-full flex flex-col items-center gap-10"
            >
                <div class="text-center">
                    <p
                        class="text-slate-400 font-mono text-[9px] uppercase tracking-[0.4em]"
                    >
                        Devitai &copy; {new Date().getFullYear()}
                    </p>
                    <p
                        class="text-slate-500 text-[9px] uppercase tracking-[0.2em]"
                    >
                        {t("footer.location")}
                    </p>
                </div>
            </div>
        </div>

        <script>
            const toggleBtn = document.getElementById("mobile-menu-toggle");
            const mobileMenu = document.getElementById("mobile-menu");
            const closeBtn = document.getElementById("mobile-menu-close");
            const menuIcon = document.getElementById("menu-icon");
            const closeIcon = document.getElementById("close-icon");
            const navLinks = document.querySelectorAll(".mobile-nav-link");

            function toggleMenu() {
                if (!mobileMenu || !menuIcon || !closeIcon) return;

                const isOpen = !mobileMenu.classList.contains("hidden");

                if (isOpen) {
                    // Close
                    mobileMenu.classList.add("opacity-0", "translate-y-8");
                    setTimeout(() => {
                        mobileMenu.classList.add("hidden");
                        mobileMenu.classList.remove("flex");
                        document.body.style.overflow = "";
                    }, 500);
                    menuIcon.classList.remove("hidden");
                    closeIcon.classList.add("hidden");
                } else {
                    // Open
                    mobileMenu.classList.remove("hidden");
                    mobileMenu.classList.add("flex");
                    // Small delay for animation
                    requestAnimationFrame(() => {
                        mobileMenu?.classList.remove(
                            "opacity-0",
                            "translate-y-8"
                        );
                    });
                    document.body.style.overflow = "hidden";
                    menuIcon.classList.add("hidden");
                    closeIcon.classList.remove("hidden");
                }
            }

            toggleBtn?.addEventListener("click", toggleMenu);
            closeBtn?.addEventListener("click", toggleMenu);

            navLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    toggleMenu();
                });
            });
        </script>

        <main class="relative z-10">
            <slot />
        </main>

        <ScrollToTop />

        <footer
            class="relative z-10 py-20 border-t border-slate-200 dark:border-slate-900 bg-white/50 dark:bg-slate-950/50 backdrop-blur-md"
        >
            <div
                class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 items-center"
            >
                <div
                    class="flex flex-col items-center md:items-start text-center md:text-left"
                >
                    <Logo class="mb-4" />
                    <p
                        class="text-slate-500 dark:text-slate-400 text-sm max-w-xs leaing-relaxed"
                    >
                        {t("footer.desc")}
                    </p>
                </div>
                <div
                    class="flex justify-center gap-10 font-bold text-[11px] tracking-[0.2em]"
                >
                    <a
                        href="mailto:info@devitai.com"
                        class="text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest flex items-center gap-2"
                    >
                        <Mail size={14} />
                        Email
                    </a>
                </div>
                <div class="text-center md:text-right">
                    <p
                        class="text-slate-500 text-xs font-mono mb-2 uppercase tracking-widest"
                    >
                        &copy; {new Date().getFullYear()} DEVITAI.
                    </p>
                    <p
                        class="text-slate-400 text-[10px] uppercase tracking-[0.2em]"
                    >
                        {t("footer.location")}
                    </p>
                </div>
            </div>
        </footer>
        <style is:global>
            /* View Transitions - Circular Theme Toggle */
            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation: none;
                mix-blend-mode: normal;
            }

            .dark::view-transition-old(root) {
                z-index: 1;
            }
            .dark::view-transition-new(root) {
                z-index: 999;
            }

            ::view-transition-old(root) {
                z-index: 999;
            }
            ::view-transition-new(root) {
                z-index: 1;
            }

            /* Main Page Styles */
            body {
                overflow-x: hidden;
            }
        </style>
        <style is:global>
            .reveal {
                opacity: 0;
                transform: translateY(30px);
                transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .reveal.active {
                opacity: 1;
                transform: translateY(0);
            }
            .reveal-delay-1 {
                transition-delay: 0.1s;
            }
            .reveal-delay-2 {
                transition-delay: 0.2s;
            }
            .reveal-delay-3 {
                transition-delay: 0.3s;
            }
            .reveal-delay-4 {
                transition-delay: 0.4s;
            }
        </style>

        <script is:inline>
            // Custom Cursor Logic
            const cursorDot = document.getElementById("cursor-dot");
            const cursorGlow = document.getElementById("cursor-glow");

            if (window.matchMedia("(pointer: fine)").matches) {
                document.addEventListener("mousemove", (e) => {
                    requestAnimationFrame(() => {
                        cursorDot.style.left = `${e.clientX}px`;
                        cursorDot.style.top = `${e.clientY}px`;
                        cursorGlow.style.left = `${e.clientX}px`;
                        cursorGlow.style.top = `${e.clientY}px`;
                    });
                });

                document.addEventListener("mousedown", () => {
                    cursorDot.style.transform = "translate(-50%, -50%) scale(0.5)";
                    cursorGlow.style.transform = "translate(-50%, -50%) scale(1.5)";
                });

                document.addEventListener("mouseup", () => {
                    cursorDot.style.transform = "translate(-50%, -50%) scale(1)";
                    cursorGlow.style.transform = "translate(-50%, -50%) scale(1)";
                });

                // Add hover effect for links and buttons
                const interactiveElements = document.querySelectorAll('a, button, input, select, textarea');
                interactiveElements.forEach(el => {
                    el.addEventListener('mouseenter', () => {
                        cursorDot.style.transform = "translate(-50%, -50%) scale(1.5)";
                        cursorDot.style.backgroundColor = "transparent";
                        cursorDot.style.border = "1px solid var(--color-primary)";
                    });
                    el.addEventListener('mouseleave', () => {
                        cursorDot.style.transform = "translate(-50%, -50%) scale(1)";
                        cursorDot.style.backgroundColor = "var(--color-primary)";
                        cursorDot.style.border = "none";
                    });
                });
            } else {
                // Hide cursor on touch devices
                cursorDot.style.display = 'none';
                cursorGlow.style.display = 'none';
                document.body.classList.remove('cursor-none');
            }

            // Scroll Reveal Observer
            const observerOptions = {
                threshold: 0.1,
                rootMargin: "0px 0px -50px 0px",
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    }
                });
            }, observerOptions);

            document
                .querySelectorAll(".reveal")
                .forEach((el) => observer.observe(el));
        </script>
    </body>
</html>
