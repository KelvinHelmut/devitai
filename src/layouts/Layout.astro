---
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
} from "../i18n/utils";
import Logo from "../components/common/Logo.astro";
import ThemeSwitcher from "../components/common/ThemeSwitcher.astro";
import LanguageSwitcher from "../components/common/LanguageSwitcher.astro";
import ScrollToTop from "../components/common/ScrollToTop.astro";
import { Menu, X, Mail, MessageSquare } from "@lucide/astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Devitai - Boutique AI & Software Engineering Agency",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />

        <!-- Theme Blocking Script -->
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>
    </head>
    <body
        class="bg-slate-50 dark:bg-[#020617] text-slate-900 dark:text-slate-100 font-sans selection:bg-blue-500/20 selection:text-blue-500 grain"
    >
        <!-- Premium Grid Background -->
        <div
            class="fixed inset-0 z-[-1] animate-grid opacity-30 dark:opacity-20 pointer-events-none"
        >
        </div>

        <!-- Background Orbs -->
        <div
            class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none animate-float"
        >
        </div>
        <div
            class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-indigo-500/10 rounded-full blur-[120px] pointer-events-none animate-float"
            style="animation-delay: -3s;"
        >
        </div>

        <!-- Header -->
        <header
            class="fixed top-0 left-0 right-0 z-[100] border-b border-slate-200/40 dark:border-white/5 backdrop-blur-2xl bg-white/60 dark:bg-slate-950/60"
        >
            <nav
                class="max-w-7xl mx-auto px-4 md:px-6 h-20 flex items-center justify-between"
            >
                <a
                    href={translatePath("/")}
                    class="hover:opacity-80 transition-opacity flex-shrink-0"
                >
                    <Logo class="scale-90 md:scale-100 origin-left" />
                </a>

                <!-- Desktop Nav -->
                <div
                    class="hidden md:flex items-center gap-10 text-sm font-semibold tracking-tight"
                >
                    <a
                        href="#services"
                        class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest text-[11px]"
                        >{t("nav.services")}</a
                    >
                    <a
                        href="#stack"
                        class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest text-[11px]"
                        >{t("nav.stack")}</a
                    >
                    <a
                        href="#contact"
                        class="px-6 py-2.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:scale-105 transition-all shadow-lg shadow-black/10 dark:shadow-white/5"
                        >{t("nav.contact")}</a
                    >
                </div>

                <!-- Right Side Tools -->
                <div class="flex items-center gap-2 md:gap-6">
                    <LanguageSwitcher />
                    <ThemeSwitcher />

                    <!-- Mobile Menu Toggle -->
                    <button
                        id="mobile-menu-toggle"
                        class="md:hidden p-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:scale-105 transition-all active:scale-95"
                        aria-label="Toggle menu"
                    >
                        <div id="menu-icon">
                            <Menu size={20} />
                        </div>
                        <div id="close-icon" class="hidden">
                            <X size={20} />
                        </div>
                    </button>
                </div>
            </nav>
        </header>

        <!-- Mobile Navigation Overlay -->
        <div
            id="mobile-menu"
            class="fixed inset-0 z-[200] bg-slate-50 dark:bg-[#020617] flex-col items-center justify-between py-16 px-8 hidden md:hidden opacity-0 translate-y-8 transition-all duration-500 overflow-y-auto"
        >
            <!-- Close button inside overlay -->
            <button
                id="mobile-menu-close"
                class="absolute top-6 right-6 p-4 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-xl"
                aria-label="Close menu"
            >
                <X size={24} />
            </button>

            <div class="flex flex-col items-center gap-10 w-full mt-12">
                <a
                    href="#"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                >
                    {t("nav.home")}
                </a>
                <a
                    href="#services"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                    >{t("nav.services")}</a
                >
                <a
                    href="#stack"
                    class="mobile-nav-link text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
                    >{t("nav.stack")}</a
                >
                <a
                    href="#contact"
                    class="mobile-nav-link px-12 py-5 rounded-[2.5rem] bg-blue-600 text-white text-2xl font-black shadow-2xl shadow-blue-500/20 text-center w-full max-w-[300px]"
                    >{t("nav.contact")}</a
                >
            </div>

            <div
                class="mt-16 pt-10 border-t border-slate-200 dark:border-white/5 w-full flex flex-col items-center gap-10"
            >
                <div class="text-center">
                    <p
                        class="text-slate-400 font-mono text-[9px] uppercase tracking-[0.4em] mb-1"
                    >
                        Devitai &copy; {new Date().getFullYear()}
                    </p>
                    <a
                        href="mailto:info@devitai.com"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        info@devitai.com
                    </a>
                    <p
                        class="text-slate-500 text-[9px] uppercase tracking-[0.2em]"
                    >
                        {t("footer.location")}
                    </p>
                </div>
            </div>
        </div>

        <script>
            const toggleBtn = document.getElementById("mobile-menu-toggle");
            const mobileMenu = document.getElementById("mobile-menu");
            const closeBtn = document.getElementById("mobile-menu-close");
            const menuIcon = document.getElementById("menu-icon");
            const closeIcon = document.getElementById("close-icon");
            const navLinks = document.querySelectorAll(".mobile-nav-link");

            function toggleMenu() {
                if (!mobileMenu || !menuIcon || !closeIcon) return;

                const isOpen = !mobileMenu.classList.contains("hidden");

                if (isOpen) {
                    // Close
                    mobileMenu.classList.add("opacity-0", "translate-y-8");
                    setTimeout(() => {
                        mobileMenu.classList.add("hidden");
                        mobileMenu.classList.remove("flex");
                        document.body.style.overflow = "";
                    }, 500);
                    menuIcon.classList.remove("hidden");
                    closeIcon.classList.add("hidden");
                } else {
                    // Open
                    mobileMenu.classList.remove("hidden");
                    mobileMenu.classList.add("flex");
                    // Small delay for animation
                    requestAnimationFrame(() => {
                        mobileMenu?.classList.remove(
                            "opacity-0",
                            "translate-y-8"
                        );
                    });
                    document.body.style.overflow = "hidden";
                    menuIcon.classList.add("hidden");
                    closeIcon.classList.remove("hidden");
                }
            }

            toggleBtn?.addEventListener("click", toggleMenu);
            closeBtn?.addEventListener("click", toggleMenu);

            navLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    toggleMenu();
                });
            });
        </script>

        <main class="relative z-10">
            <slot />
        </main>

        <ScrollToTop />

        <footer
            class="relative z-10 py-20 border-t border-slate-200 dark:border-slate-900 bg-white/50 dark:bg-slate-950/50 backdrop-blur-md"
        >
            <div
                class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 items-center"
            >
                <div>
                    <Logo class="mb-4" />
                    <p
                        class="text-slate-500 dark:text-slate-400 text-sm max-w-xs leaing-relaxed"
                    >
                        {t("footer.desc")}
                    </p>
                </div>
                <div
                    class="flex justify-center gap-10 font-bold text-[11px] tracking-[0.2em]"
                >
                    <a
                        href="mailto:info@devitai.com"
                        class="text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest flex items-center gap-2"
                    >
                        <Mail size={14} />
                        Email</a
                    >
                    <a
                        href="https://wa.me/51954733536"
                        target="_blank"
                        class="text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest flex items-center gap-2"
                    >
                        <MessageSquare size={14} />
                        WhatsApp</a
                    >
                </div>
                <div class="text-right">
                    <p
                        class="text-slate-500 text-xs font-mono mb-2 uppercase tracking-widest"
                    >
                        &copy; {new Date().getFullYear()} DEVITAI.
                    </p>
                    <p
                        class="text-slate-400 text-[10px] uppercase tracking-[0.2em]"
                    >
                        {t("footer.location")}
                    </p>
                </div>
            </div>
        </footer>
        <style is:global>
            body {
                overflow-x: hidden;
            }
        </style>
    </body>
</html>
